local lane
local zoom_lane
local ini
local current
local steps_by_weapon = {}
local tan, atan, rad, deg = math.tan, math.atan, math.rad, math.deg

local function get_optic(item)
    if not (lane and item and z_3d_scopes and ini) then return end
    local weapon = item:cast_Weapon()
    if not weapon or weapon:GetZoomType() ~= 0 or not weapon:IsZoomed() then return end
    local section = item:section()
    if not ini:section_exist(section) then return end
    local effective_section = magnifier_switch and magnifier_switch.get_effective_section
        and magnifier_switch.get_effective_section(item) or section
    local key = effective_section
    if ini:r_bool_ex(section, "modular", false) then
        key = z_3d_scopes.get_sight_section(item, 0)
    end
    if not key or not ini:line_exist(section, "camera") or not ini:line_exist(section, key .. "_min") then return end
    return weapon, section, key, item:id()
end

local function clear()
    if current then
        current = nil
        shader_bus.set(lane, 0, 0, 0, 0)
        shader_bus.set(zoom_lane, 0, 0, 0, 0)
    end
end

local function apply(item)
    local weapon, section, key, id = get_optic(item)
    if not weapon then clear() return false end
    local fov = get_console():get_float("fov")
    if not fov or fov <= 0 or fov >= 179 then clear() return false end

    if not current or current.id ~= id or current.key ~= key then
        local minimum = ini:r_float_ex(section, key .. "_min", 1)
        local maximum = ini:r_float_ex(section, key .. "_max", minimum)
        local steps = ini:r_float_ex(section, key .. "_steps", 0)
        local existing = steps_by_weapon[id]
        current = {
            id = id, section = section, key = key, minimum = minimum, maximum = maximum,
            steps = steps, step = existing and existing.section == section and existing.key == key
                and math.min(existing.step, steps) or 0,
            camera = ini:r_float_ex(section, "camera", 90),
        }
    end

    local minimum, maximum, steps = current.minimum, current.maximum, current.steps
    local magnification = minimum
    if steps > 0 then magnification = minimum + (maximum - minimum) * current.step / steps end
    local view = tan(rad(fov / 2))
    local lens_fov = deg(2 * atan(view / magnification))
    local wide_fov = deg(2 * atan(view / minimum))
    local narrow_fov = deg(2 * atan(view / maximum))
    local scale = view / (magnification * tan(rad(current.camera / 2)))
    -- The camera and the lens have independent FOVs. The secondary render uses
    -- the widest optical setting, with projected UVs for narrower settings.
    shader_bus.set(lane, 1, scale, lens_fov, fov)
    shader_bus.set(zoom_lane, wide_fov, narrow_fov, magnification, minimum)
    weapon:SetZoomFactor(fov / 0.75)
    return true
end

function apply_if_scoped(item)
    return apply(item)
end

local function on_update()
    if db.actor then apply(db.actor:active_item()) else clear() end
end

local function change_zoom(direction)
    if not (db.actor and actor_menu.is_hud_free() and apply(db.actor:active_item())) then return false end
    if current.steps <= 0 then return false end
    current.step = math.max(0, math.min(current.steps, current.step + direction))
    steps_by_weapon[current.id] = { section = current.section, key = current.key, step = current.step }
    apply(db.actor:active_item())
    return true
end

local function on_mouse_wheel(direction, flags)
    if flags.ret_value == false then return end
    local direction = tonumber(direction)
    if direction ~= 1 and direction ~= 0 then return end
    local sign = direction == 1 and 1 or -1
    if get_console():get_bool("mouse_wheel_invert_zoom") then sign = -sign end
    if change_zoom(sign) then flags.ret_value = false end
end

local function on_before_key_press(_, bind, _, flags)
    if not flags or flags.ret_value == false then return end
    if bind == key_bindings.kWPN_ZOOM_INC and change_zoom(1) then flags.ret_value = false
    elseif bind == key_bindings.kWPN_ZOOM_DEC and change_zoom(-1) then flags.ret_value = false end
end

local function on_zoom_type_changed(item)
    apply(item)
end

local function on_unregister(object)
    steps_by_weapon[object.id] = nil
end

function on_game_start()
    if not shader_bus or shader_bus.version() < 7 then return end
    lane = shader_bus.register("romeo_pip", "Romeo PiP Optics", "Active, projection scale, lens FOV, view FOV")
    zoom_lane = shader_bus.register("romeo_pip_zoom", "Romeo PiP Optics", "Wide FOV, narrow FOV, current and minimum magnification")
    if not (lane and zoom_lane) then lane = nil return end
    ini = ini_file("romeo_pip_optics.ltx")
    RegisterScriptCallback("actor_on_update", on_update)
    RegisterScriptCallback("actor_on_weapon_zoom_out", clear)
    RegisterScriptCallback("actor_on_weapon_zoom_type_changed", on_zoom_type_changed)
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("server_entity_on_unregister", on_unregister)
end

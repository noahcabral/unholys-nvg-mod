local SLOT = 10
local SAVE_KEY = "romeo_pvs69"
local active, failed, restored, lane, config
local motion_lane, sensor, previous_camera
local layouts = {
    analog_bino = 1, analog_mono = 2, analog_quad = 3,
    analog_quad_hud = 4, analog_quad_hud_corrected = 5,
    analog_bino_hud_bezel = 6, analog_quad_hud_bezel = 7, digital_bino_hud_bezel = 8, digital_mono = 9,
}

local function is_digital(generation)
    return generation == 4 or generation == 5
end

local function show(active_generation, variant)
    sensor = active_generation
    if active_generation == 0 then romeo_nvg_laser.clear() end
    if lane then
        local fov = is_digital(active_generation) and 48 or 40
        shader_bus.set(lane, active_generation, 1, fov, layouts[variant] or 0)
    end
    if motion_lane and not is_digital(active_generation) then
        previous_camera = nil
        shader_bus.set(motion_lane, 0, 0, 0, 0)
    end
end

local function update_motion()
    if not is_digital(sensor) or not motion_lane then return end
    local camera = device()
    local fwd, right = camera.cam_dir, camera.cam_right
    local now = time_global()
    if previous_camera then
        local x, y, z = previous_camera.x - fwd.x, previous_camera.y - fwd.y, previous_camera.z - fwd.z
        local up_x = fwd.y * right.z - fwd.z * right.y
        local up_y = fwd.z * right.x - fwd.x * right.z
        local up_z = fwd.x * right.y - fwd.y * right.x
        local step = 20 / math.max(8, now - previous_camera.time)
        local horizontal = math.max(-.045, math.min(.045, step * (x * right.x + y * right.y + z * right.z)))
        local vertical = math.max(-.045, math.min(.045, -step * (x * up_x + y * up_y + z * up_z)))
        shader_bus.set(motion_lane, horizontal, vertical, 0, 0)
    end
    previous_camera = {x = fwd.x, y = fwd.y, z = fwd.z, time = now}
end

local function clear()
    if active then romeo_nvg_stow_view.stop() end
    active = nil
end

local function update()
    local actor = db.actor
    if not actor or not actor:alive() then
        clear()
        failed = nil
        return
    end
    local item = actor:item_in_slot(SLOT)
    local section = item and item:section()
    local id = item and item:id()
    if active and active.actor == actor and active.id == id then
        update_motion()
        if sensor > 0 then romeo_nvg_laser.update(actor) end
        return
    end
    clear()
    if not section or not config:line_exist(section, "romeo_nvg_variant") then
        failed = nil
        return
    end
    if failed == id then return end

    local variant = config:r_string(section, "romeo_nvg_variant")
    local generation = config:r_u32(section, "romeo_nvg_generation")
    local state = restored and restored.section == section and restored.pose or nil
    restored = nil
    if romeo_nvg_stow_view.start(variant, function(powered, mesh_variant)
        show(powered and generation or 0, mesh_variant)
    end, state, generation) then
        active = {actor = actor, id = id, section = section}
        failed = nil
    else
        failed = id
        printf("Romeo PVS-69: could not attach %s", variant)
    end
end

local function save_state(data)
    data[SAVE_KEY] = active and {section = active.section, pose = romeo_nvg_stow_view.save()} or restored
end

local function load_state(data)
    clear()
    failed = nil
    restored = data[SAVE_KEY]
end

function on_game_start()
    if not shader_bus or shader_bus.version() < 7 then
        printf("Romeo PVS-69 requires the xrRazom DX11 shader bus")
        return
    end
    lane = shader_bus.register("romeo_nvg", "Romeo PVS-69", "Active sensor, brightness, field of view, layout")
    if not lane then return end
    motion_lane = shader_bus.register("romeo_nvg_motion", "Romeo PVS-69", "Digital sensor motion blur")
    romeo_nvg_laser.init()
    config = system_ini()
    show(0)
    if xrr_peer_mdata then xrr_peer_mdata.register(SAVE_KEY) end
    RegisterScriptCallback("actor_on_update", update)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
end

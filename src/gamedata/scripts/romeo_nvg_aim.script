local lane, config, pip
local weapon_id, last_update
local weight = 0

local function canted_sight(item, weapon_section)
    if not (scripted_canted_irons and scripted_canted_irons.get_installed_section) then return end
    local sight = scripted_canted_irons.get_installed_section(item)
    if not (sight and config:section_exist(sight)) then return end
    local kind = config:r_string_ex(sight, "canted_attachment_type")
    local image_type = config:r_float_ex(sight, "s3ds_image_type", 0)
    if (kind ~= "irons" and kind ~= "rds") or image_type ~= 0 then return end

    if hud_adjust_owner and hud_adjust_owner.owns("canted", item) then return sight end
    local parent = config:r_string_ex(weapon_section, "parent_section")
    local key = "canted_aim_pos_" .. sight
    if config:line_exist(weapon_section, key)
        or (parent and config:section_exist(parent) and config:line_exist(parent, key)) then
        return sight
    end
end

local function primary_sight(item, section)
    if magnifier_switch and magnifier_switch.get_state and magnifier_switch.is_bone_mode
        and magnifier_switch.is_bone_mode(item) then
        return magnifier_switch.get_state(item) == 0 and section or nil
    end
    local sight = z_3d_scopes and z_3d_scopes.get_sight_section and z_3d_scopes.get_sight_section(item, 0)
    if not (sight and config:section_exist(sight)) then return end
    if config:r_bool_ex(sight, "red_dot", false) and config:r_float_ex(sight, "s3ds_image_type", 0) == 0 then
        if pip and pip:section_exist(section) and pip:r_float_ex(section, sight .. "_max", 1) > 1.01 then return end
        return sight
    end
end

function select_sight(item, zoom_type)
    if not (config and item and IsWeapon(item)) then return end
    local section = item:section()
    if not config:section_exist(section) then return end
    if zoom_type == 1 then
        local sight = canted_sight(item, section)
        if sight then return "canted", sight end
    elseif zoom_type == 0 then
        local sight = primary_sight(item, section)
        if sight then return "reflex", sight end
    end
    return "ready"
end

local function clear()
    weapon_id, last_update = nil, nil
    if weight ~= 0 then
        weight = 0
        shader_bus.set(lane, 0, 0, 0, 0)
    end
end

local function update()
    local actor = db.actor
    local active, generation, _, _, layout = shader_bus.get("romeo_nvg")
    if not actor or not actor:alive() or not active or generation == 0 or layout < 6 or layout > 8
        or not actor_menu.is_hud_free() then return clear() end
    local item = actor:active_item()
    if not (item and IsWeapon(item)) or item:get_state() == hud_state.hidden then return clear() end
    local weapon = item:cast_Weapon()
    if not (weapon and weapon.GetZoomRotateTime) then return clear() end

    local id = item:id()
    if id ~= weapon_id then clear() end
    weapon_id = id
    local now = time_global()
    local elapsed = last_update and math.max(0, now - last_update) or 0
    last_update = now
    local sight = select_sight(item, weapon:GetZoomType())
    if sight ~= "reflex" and sight ~= "canted" then return clear() end
    local aiming = weapon:IsZoomed()
    local duration = math.max(0.001, weapon:GetZoomRotateTime())
    local change = elapsed / (duration * 1000)
    local next_weight = math.max(0, math.min(1, weight + (aiming and change or -change)))
    if next_weight == weight then return end
    weight = next_weight
    shader_bus.set(lane, weight, 0, 0, 0)
end

function on_game_start()
    if not shader_bus or shader_bus.version() < 7 then return end
    lane = shader_bus.register("romeo_nvg_aim", "Romeo PVS-69", "Blend toward the right-eye ADS view")
    if not lane then return end
    config = system_ini()
    if getFS():exist("$game_config$", "romeo_pip_optics.ltx") then
        pip = ini_file("romeo_pip_optics.ltx")
    end
    RegisterScriptCallback("actor_on_update", update)
    RegisterScriptCallback("load_state", clear)
end

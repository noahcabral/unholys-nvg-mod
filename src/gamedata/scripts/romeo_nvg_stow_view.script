local ATTACHMENT_NAME = "romeo_nvg_view"
local MESH_DIRECTORY = "dynamics\\romeo_nvg\\"
local FOCUS_RAMP_MS = 300
local camera_offsets = {
    digital_bino = {.0007, .0553, .094, true},
    analog_bino = {.0007, .0553, .094, true},
    digital_mono = {-.06165, .0406, .093, false},
    analog_mono = {-.06165, .0406, .093, false},
    analog_quad = {0, .0644, .160, false},
}
local active, fit_lane
local last_weight, last_focus

local function first_person()
    return not level.get_active_cam or level.get_active_cam() == 0
end

local function update_fit(view, now)
    if not fit_lane then return end
    local weight = view and view.first_person and view.bezel and view.controller:deployed_weight(now) or 0
    local focused = view and view.first_person and view.controller.pose == "deployed"
        and not view.controller.transition and actor_menu.is_hud_free()
    local focus = 0
    if view and view.first_person then
        local target = focused and 1 or 0
        local elapsed = now - (view.focus_time or now)
        local previous = view.focus or 0
        local step = math.max(0, elapsed) / FOCUS_RAMP_MS
        focus = previous + math.max(-step, math.min(step, target - previous))
        view.focus, view.focus_time = focus, now
    elseif view then
        view.focus, view.focus_time = 0, now
    end
    if weight ~= last_weight or focus ~= last_focus then
        shader_bus.set(fit_lane, weight, focus, 0, 0)
        last_weight, last_focus = weight, focus
    end
end

local function idle(view)
    local clip = "idle_" .. view.controller.pose
    view.model:play_motion(clip, false, 1)
    if view.world then view.world.model:play_motion(clip, false, 1) end
end

function stop()
    if not active then return end
    local view = active
    active = nil
    update_fit(nil, 0)
    view.power(false)
    if db.actor == view.actor then
        view.actor:remove_attachment(ATTACHMENT_NAME)
    end
    romeo_nvg_world.stop(view.world)
    return view.controller:save()
end

function save()
    return active and active.controller:save()
end

function start(variant, power, saved, generation)
    local actor = db.actor
    local offset = camera_offsets[variant]
    if not actor or not offset or type(power) ~= "function" or not script_attachment_type
        or not script_attachment_type.CamAttached then
        return false
    end
    local mesh_variant = variant
    local path = MESH_DIRECTORY .. mesh_variant
    local bezel = fit_lane and (variant == "analog_bino" or variant == "analog_quad" or variant == "digital_bino")
        and getFS():exist("$game_meshes$", path .. "_hud_bezel.ogf")
    if bezel then
        mesh_variant = variant .. "_hud_bezel"
        path = MESH_DIRECTORY .. mesh_variant
    elseif variant == "analog_quad" then
        if getFS():exist("$game_meshes$", path .. "_hud_corrected.ogf") then
            mesh_variant = "analog_quad_hud_corrected"
        elseif getFS():exist("$game_meshes$", path .. "_hud.ogf") then
            mesh_variant = "analog_quad_hud"
        end
        path = MESH_DIRECTORY .. mesh_variant
    end
    if not getFS():exist("$game_meshes$", path .. ".ogf") then return false end
    stop()
    local model = actor:add_attachment(ATTACHMENT_NAME, path)
    if not model then return false end
    model:set_type(script_attachment_type.CamAttached)
    model:set_position(offset[1], offset[2], offset[3])
    local world = romeo_nvg_world.start(actor, variant, generation)
    local visible = first_person()
    model:set_bone_visible(0, visible, true)
    local reported
    local function set_power(powered)
        if db.actor == actor then romeo_nvg_world.update(world, not visible, powered) end
        powered = powered and visible
        if powered ~= reported then
            power(powered, mesh_variant)
            reported = powered
        end
    end
    local controller = romeo_nvg_stow.new(offset[4], function(clip)
        if model:play_motion(clip, false, 1) == 0 then return false end
        if world then world.model:play_motion(clip, false, 1) end
        return true
    end, set_power, saved)
    active = {actor = actor, model = model, world = world, controller = controller, power = set_power,
        pressed = false, bezel = bezel, first_person = visible,
        switch_camera = function(next_visible)
            visible = next_visible
            model:set_bone_visible(0, visible, true)
        end}
    idle(active)
    if not controller:equip(time_global()) then
        stop()
        return false
    end
    if not controller.transition then set_power(controller.pose == "deployed") end
    update_fit(active, time_global())
    return true
end

local function before_press(dik, binding, disabled, flags)
    if not active or not flags or binding ~= key_bindings.kNIGHT_VISION then return end
    flags.ret_value = false
    if disabled or not actor_menu.is_hud_free() then return end
    active.pressed = true
    active.controller:press(time_global())
end

local function before_release(dik, binding, disabled, flags)
    if not active or not flags or binding ~= key_bindings.kNIGHT_VISION then return end
    flags.ret_value = false
    active.pressed = false
    active.controller:release()
end

local function update()
    if not active then return end
    if db.actor ~= active.actor or not db.actor:alive() then stop(); return end
    local controller = active.controller
    local transitioning = controller.transition ~= nil
    local now = time_global()
    local visible = first_person()
    if visible ~= active.first_person then
        active.first_person = visible
        active.switch_camera(visible)
        active.power(not controller.transition and controller.pose == "deployed")
    end
    controller:update(now)
    if transitioning and not controller.transition then idle(active) end
    romeo_nvg_world.update(active.world, not visible, not controller.transition and controller.pose == "deployed")
    update_fit(active, now)
end

function on_game_start()
    if shader_bus and shader_bus.version() >= 7 then
        fit_lane = shader_bus.register("romeo_nvg_fit", "Romeo PVS-69 fit", "Projection blend and depth of field")
    end
    RegisterScriptCallback("on_before_key_press", before_press)
    RegisterScriptCallback("on_before_key_release", before_release)
    RegisterScriptCallback("actor_on_update", update)
end

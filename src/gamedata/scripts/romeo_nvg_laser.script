local beam_start, beam_finish, pick
local published = false
local range = 45.0

local function beam_for_section(section)
    local config = system_ini()
    local hud = config:r_string_ex(section, "hud")
    local model = hud and config:r_string_ex(hud, "item_visual")
    if not model then return nil end
    model = model:lower():gsub("\\", "/")
    if model:sub(-4) ~= ".ogf" then model = model .. ".ogf" end
    return romeo_nvg_laser_catalog.models[model]
end

local function world_point(weapon, parts, position)
    position:set(0, 0, 0)
    for _, part in ipairs(parts) do
        local bone, x, y, z, weight = unpack(part)
        local id = weapon:get_bone_id(bone, true)
        if not id or id >= 65535 or not weapon:bone_visible(id, true) then return false end
        local point = vector():set(x, y, z)
        weapon:bone_transform(id, true):transform_tiny(point)
        position:add(point:mul(weight))
    end
    position:hud_to_world()
    return true
end

function clear()
    if not published then return end
    shader_bus.set(beam_start, 0, 0, 0, 0)
    shader_bus.set(beam_finish, 0, 0, 0, 0)
    published = false
end

function update(actor)
    if not beam_start or not beam_finish then return end
    local weapon = actor:active_item()
    if not weapon or not IsWeapon(weapon) or weapon:get_state() == hud_state.hidden then return clear() end
    local parameters = get_console():get_string("shader_param_6") or ""
    local brightness = tonumber(parameters:match("^%s*%(%s*[^,]+,%s*([^,]+),"))
    if not brightness or brightness == 0 then return clear() end
    local section = weapon:section()
    if not system_ini():r_bool_ex(section, "laser_status", false) then return clear() end
    local beam = beam_for_section(section)
    if not beam then return clear() end
    local from, to = vector(), vector()
    if not world_point(weapon, beam[1], from) or not world_point(weapon, beam[2], to) then return clear() end
    if to:distance_to(device().cam_pos) < from:distance_to(device().cam_pos) then from, to = to, from end
    local direction = vector():set(to.x, to.y, to.z):sub(from)
    if direction:magnitude() < 0.01 then return clear() end
    direction:normalize()
    pick:set_position(from)
    pick:set_direction(direction)
    pick:set_ignore_object(actor)
    local distance = pick:query() and pick:get_distance() or range
    to:set(from.x, from.y, from.z):add(direction:mul(distance))
    shader_bus.set(beam_start, from.x, from.y, from.z, math.abs(brightness))
    shader_bus.set(beam_finish, to.x, to.y, to.z, 0)
    published = true
end

function init()
    beam_start = shader_bus.register("romeo_nvg_beam_start", "Romeo PVS-69", "Laser emitter and enable signal")
    beam_finish = shader_bus.register("romeo_nvg_beam_finish", "Romeo PVS-69", "Laser endpoint in world space")
    pick = ray_pick()
    pick:set_flags(rq_target.rqtStatic + rq_target.rqtObject)
    pick:set_range(range)
end

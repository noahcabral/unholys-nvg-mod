local frames = {mount_to_pods = 41, pods_flatten = 13, pods_align = 13, mount_raise = 17, mount_lower = 17}

local Controller = {}
Controller.__index = Controller

function new(articulated, play, power, saved)
    local pose = saved and saved.pose
    if articulated and pose == "mount_flat" then pose = "pods" end
    if pose ~= "deployed" and not (articulated and pose == "pods") then
        pose = "mount_aligned"
    end
    return setmetatable({articulated = articulated, pose = pose,
        play = play, power = power}, Controller)
end

function Controller:save()
    return {pose = self.transition and self.transition.pose or self.pose}
end

function Controller:start(now, clip, pose)
    if self.play(clip) == false then return false end
    self.transition = {pose = pose, starts = now, ends = now + math.ceil(frames[clip] * 1000 / 30)}
    self.power(false)
    return true
end

function Controller:equip(now)
    if self.articulated and self.pose == "mount_aligned" and not self.transition then
        return self:start(now, "mount_to_pods", "pods")
    end
    return true
end

function Controller:press(now)
    if self.pressed then return end
    self.pressed = true
    if self.transition then return end
    if self.articulated then
        if self.pose == "deployed" then
            return self:start(now, "pods_flatten", "pods")
        elseif self.pose == "pods" then
            return self:start(now, "pods_align", "deployed")
        end
    elseif self.pose == "deployed" then
        return self:start(now, "mount_raise", "mount_aligned")
    else
        return self:start(now, "mount_lower", "deployed")
    end
end

function Controller:update(now)
    if self.transition and now >= self.transition.ends then
        self.pose = self.transition.pose
        self.transition = nil
        self.power(self.pose == "deployed")
    end
end

function Controller:deployed_weight(now)
    local source = self.pose == "deployed" and 1 or 0
    if not self.transition then return source end
    local target = self.transition.pose == "deployed" and 1 or 0
    local start_at, end_at = self.transition.starts, self.transition.ends
    local t = math.max(0, math.min(1, (now - start_at) / (end_at - start_at)))
    return source + (target - source) * t * t * (3 - 2 * t)
end

function Controller:release()
    self.pressed = false
end

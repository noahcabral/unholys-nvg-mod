#include "romeo_nvg_lens.h"

struct RomeoNvgDisplayOutput
{
    float4 color : SV_Target;
    float depth : SV_DepthLessEqual;
};

RomeoNvgDisplayOutput main(noperspective centroid float4 position : SV_Position, float2 aperture : TEXCOORD0)
{
    RomeoNvgDisplayOutput output;
    output.color = RomeoNvgLens(position.xy, aperture, false);
    output.depth = position.z;
#if defined(SHADER_BUS) && SHADER_BUS >= 7
    uint generation = uint(round(bus_romeo_nvg.x));
    if (RomeoNvgIsDigital(generation)
        && uint(round(bus_romeo_nvg.w)) == RomeoNvgDigitalBezelLayout
        && ssfx_issvp.x <= 0.5 && RomeoNvgDigitalEdge(aperture * 2.0 - 1.0) < 1.0)
    {
        // The black backing retains its ordinary depth. Only the active
        // screen takes priority over the overlapping opposite housing.
        output.depth = min(position.z, 0.00001);
    }
#endif
    return output;
}

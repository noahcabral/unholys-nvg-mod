#include "common.h"

float4 main(float2 uv : TEXCOORD0, float3 eyeToSurface : TEXCOORD2, float3 worldNormal : TEXCOORD3) : SV_Target
{
    float4 surface = s_base.Sample(smp_base, uv);
    float3 normal = normalize(worldNormal);
    float3 towardSun = -normalize(L_sun_dir_w.xyz);
    float3 halfVector = normalize(towardSun - normalize(eyeToSurface));
    float sky = normal.y * 0.5 + 0.5;
    float hemi = saturate(L_material.x / 0.75);
    float exposure = saturate(L_material.y / 0.75);
    float diffuse = saturate(dot(normal, towardSun));
    float roughness = saturate(surface.a);
    float specular = pow(saturate(dot(normal, halfVector)), lerp(48.0, 12.0, roughness));
    float3 indirect = L_ambient.rgb + L_hemi_color.rgb * lerp(0.36, 0.85, sky) * hemi;
    float3 direct = L_sun_color.rgb * exposure * diffuse;
    return float4(surface.rgb * (indirect + direct) + direct * specular * (1.0 - roughness) * 0.12, 1.0);
}
